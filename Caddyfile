# TLS terminator. Set APP_DOMAIN in .env:
#   exams.example.com   -> Caddy obtains and renews a Let's Encrypt certificate,
#                          and automatically redirects HTTP to HTTPS
#   :80                 -> plain HTTP. LOCAL DEVELOPMENT ONLY. There is no
#                          redirect and no TLS, so passwords, the invite code and
#                          the session token all cross the network in the clear.
{
	# Without a contact address the ACME account gets no expiry or revocation
	# notifications.
	email {$ACME_EMAIL}
}

{$APP_DOMAIN} {
	encode gzip zstd

	reverse_proxy frontend:80 {
		health_uri /index.html
		health_interval 30s
	}

	log {
		output stdout
		format console
	}
}
