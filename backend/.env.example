# Bare-metal development only. In Docker these come from the repo-root .env
# (see .env.example there) and are injected by docker-compose.yml.

# +psycopg selects psycopg3, which backs both the app's async engine and the
# entrypoint's sync one. A bare postgresql:// URL will not work.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/mcq_app

# Must be at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=

# Code required to register an INSTRUCTOR account. Empty closes instructor
# sign-ups. Students do not use this: they register with their instructor's
# personal code, which is shown on that instructor's account page and is what
# links the two accounts together.
AUTH_INSTRUCTOR_INVITE_CODE=

# Read only by Alembic revision 0002, which creates the first instructor account.
# Change this password in the app once the migration has run.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# `local` or `staging` serves /docs and /redoc; anything else disables them.
ENVIRONMENT=local
