# Copy to .env before `docker compose up`. Compose refuses to start without the
# required values rather than falling back to a guessable default.
#
# Generate the two secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Database ---
POSTGRES_USER=postgres
POSTGRES_DB=mcq_app
POSTGRES_PASSWORD=

# --- Application ---
# At least 32 characters. Changing it signs every existing session out.
AUTH_SECRET=
# Shared code required to register an account. Rotate it after enrolment.
AUTH_INVITE_CODE=

# --- First instructor account ---
# Used ONCE, by Alembic revision 0002. Nothing else can mint an instructor, so
# without it the admin dashboard is unreachable for everyone.
#
# After the first successful deploy:
#   1. sign in and change the password (Account -> Change password), which also
#      signs out every existing session for that account;
#   2. blank both values here and redeploy, so the standing instructor password
#      no longer sits in the container environment.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# --- Serving ---
# REQUIRED. A hostname (exams.example.com) makes Caddy fetch a Let's Encrypt
# certificate and redirect HTTP to HTTPS.
#
# `:80` is accepted for local development only — it serves plain HTTP with no
# redirect, so passwords, the invite code and session tokens are sent in the
# clear. Never use it for anything reachable from a network you do not control.
APP_DOMAIN=

# Contact address for the ACME account (certificate expiry notices).
ACME_EMAIL=

# --- Tuning ---
# `local` or `staging` serves /docs and /redoc; anything else disables them.
ENVIRONMENT=production
WEB_CONCURRENCY=3
LOG_LEVEL=INFO
